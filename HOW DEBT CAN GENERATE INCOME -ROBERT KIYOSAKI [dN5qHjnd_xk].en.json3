  }, {
    "tStartMs": 472670,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "as we've talked about earlier,"
    } ]
  }, {
    "tStartMs": 473890,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "the six words that are basics"
    } ]
  }, {
    "tStartMs": 475690,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "of financial education,\nfinancial intelligence,"
    } ]
  }, {
    "tStartMs": 478900,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "income, expense, asset, liability."
    } ]
  }, {
    "tStartMs": 481870,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And the two other words are cash flow."
    } ]
  }, {
    "tStartMs": 484240,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "So when you look at the average person"
    } ]
  }, {
    "tStartMs": 486500,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "to have a job, money comes in here,"
    } ]
  }, {
    "tStartMs": 491640,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "they pay for their house,\nand the money goes to a bank,"
    } ]
  }, {
    "tStartMs": 497770,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "through a mortgage, so it's not an asset"
    } ]
  }, {
    "tStartMs": 501160,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "because the cash is flowing\nout, so it's a liability."
    } ]
  }, {
    "tStartMs": 505300,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "So the definition of liability,"
    } ]
  }, {
    "tStartMs": 507840,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "does it take money from your pocket?"
    } ]
  }, {
    "tStartMs": 510290,
    "dDurationMs": 2903,
    "segs": [ {
      "utf8": "And for an asset does it\nput money in your pocket?"
