  }, {
    "tStartMs": 604956,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Alexandra] Yeah."
    } ]
  }, {
    "tStartMs": 605789,
    "dDurationMs": 1421,
    "segs": [ {
      "utf8": "- Any comments on this?"
    } ]
  }, {
    "tStartMs": 607210,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "- So numerous people my age\nactually think debt is horrible"
