    "segs": [ {
      "utf8": "repairs and upkeep,\ninsurance and all this."
    } ]
  }, {
    "tStartMs": 531840,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "When I rent a property, I've\ndone a good job buying it"
