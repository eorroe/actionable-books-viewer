    "segs": [ {
      "utf8": "the real applications of accounting."
    } ]
  }, {
    "tStartMs": 767470,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "As opposed to a fake teacher, right?"
    } ]
  }, {
    "tStartMs": 770000,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "So your advisor, Tom Wheelwright\ntaught me in one hour"
    } ]
  }, {
    "tStartMs": 774010,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "what I could have learned\nthe entire semester"
    } ]
  }, {
    "tStartMs": 775930,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "with this one teacher that wasn't even"
    } ]
  }, {
    "tStartMs": 778020,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "an accountant in his real life."
    } ]
  }, {
    "tStartMs": 779920,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "- A big lesson for you is\nthat it's nothing to do"
    } ]
  }, {
    "tStartMs": 782550,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "with the house, the car, the student loan,"
    } ]
  }, {
    "tStartMs": 784740,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "it has to do with\nwhere's the cash flowing."
    } ]
  }, {
    "tStartMs": 787250,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "If the cash is flowing in\nto your income statement,"
    } ]
  }, {
    "tStartMs": 790100,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "into your pocket, it's\nan asset, it's good debt."
    } ]
  }, {
    "tStartMs": 794600,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "But if it's taking money from\nyour pocket, it's bad debt."
    } ]
  }, {
    "tStartMs": 798400,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "About debt, there's\ngood debt and bad debt."
    } ]
  }, {
    "tStartMs": 801630,
    "dDurationMs": 868,
    "segs": [ {
      "utf8": "Any comments on that?"
    } ]
  }, {
    "tStartMs": 802498,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Well I think just like Trump,"
    } ]
  }, {
    "tStartMs": 803331,
    "dDurationMs": 1779,
    "segs": [ {
      "utf8": "you know how to apply the rules of debt"
    } ]
  }, {
    "tStartMs": 805110,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "and he calls himself\nthe king of debt, right?"
    } ]
  }, {
    "tStartMs": 806800,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "- If you're gonna be successful at"
    } ]
  }, {
    "tStartMs": 808050,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "whether you're employee or entrepreneur,"
    } ]
  }, {
    "tStartMs": 810400,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "you've got to control the\ndirection of your cash flow."
    } ]
  }, {
    "tStartMs": 814270,
    "dDurationMs": 2663,
    "segs": [ {
      "utf8": "So like most people here,\nwe've talked about earlier,"
    } ]
  }, {
    "tStartMs": 817850,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "they got a job and the\ncash flows out here,"
    } ]
  }, {
    "tStartMs": 820120,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "it goes to the government, called taxes."
    } ]
  }, {
    "tStartMs": 828690,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Trump doesn't do this, I\ndon't do this, legally."
    } ]
  }, {
    "tStartMs": 832070,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The reason's 'cause we're\nentrepreneurs, not employees."
    } ]
  }, {
    "tStartMs": 834650,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "Employees have this, entrepreneurs don't."
    } ]
  }, {
    "tStartMs": 839330,
    "dDurationMs": 2323,
    "segs": [ {
      "utf8": "Because it's a type of asset."
    } ]
  }, {
    "tStartMs": 842990,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Any other thing?"
    } ]
  }, {
    "tStartMs": 844960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "- [Alexandra] I'm good."
    } ]
  }, {
    "tStartMs": 846160,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "- So what would you like to say"
    } ]
  }, {
    "tStartMs": 847350,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "to the young millennials\nlistening to this?"
    } ]
  }, {
    "tStartMs": 850460,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "- I'd say don't be afraid of debt"
    } ]
  }, {
    "tStartMs": 852100,
    "dDurationMs": 1387,
    "segs": [ {
      "utf8": "and if you know how to use it, use it."
    } ]
  }, {
    "tStartMs": 853487,
    "dDurationMs": 1363,
    "segs": [ {
      "utf8": "- Good debt puts--"
    } ]
  }, {
    "tStartMs": 854850,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- Money in your pocket."
    } ]
  }, {
    "tStartMs": 856020,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "- Could a credit card be good debt?"
    } ]
  }, {
    "tStartMs": 857560,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "- Well it just depends what\nyou spend the money on, right?"
    } ]
  }, {
    "tStartMs": 859910,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "So if you spent it on something that's"
    } ]
  }, {
    "tStartMs": 861630,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "gonna produce income for you,"
    } ]
  }, {
    "tStartMs": 863250,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "like an asset then it's good debt"
    } ]
  }, {
    "tStartMs": 865340,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "but if you spend it on let's say"
    } ]
  }, {
    "tStartMs": 867370,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "a jacket that you wanted\nfrom Burberry, then it's not."
    } ]
  }, {
    "tStartMs": 870050,
    "dDurationMs": 4103,
    "segs": [ {
      "utf8": "- First property there, it was\nin Maui, Hawaii, the 1970s."
    } ]
  }, {
    "tStartMs": 875550,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "I bought it with a credit card."
    } ]
  }, {
    "tStartMs": 876960,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "- Wow."
    } ]
  }, {
    "tStartMs": 878270,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "- Property was $18,000 my first,"
    } ]
  }, {
    "tStartMs": 881500,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "but I've taken several real estate classes"
    } ]
  }, {
    "tStartMs": 884270,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and so I knew what to look\nfor, I found this one property."
    } ]
  }, {
    "tStartMs": 886590,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "It took a long time, when I found it,"
    } ]
  }, {
    "tStartMs": 888910,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "I just broke out my\ncredit card and bought it"
    } ]
  }, {
    "tStartMs": 891420,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "and it put $25 in my pocket."
    } ]
  }, {
    "tStartMs": 893330,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "It went from this little,\njanky little thing."
    } ]
  }, {
    "tStartMs": 896790,
    "dDurationMs": 1553,
    "segs": [ {
      "utf8": "This was years ago, $25."
    } ]
  }, {
    "tStartMs": 902210,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "It was good debt, I wish\nI had never sold it."
    } ]
  }, {
    "tStartMs": 905290,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "I don't, you know it was\na big mistake to sell it"
    } ]
  }, {
    "tStartMs": 908350,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "because today it's probably\nworth four or 500,000"
    } ]
  }, {
    "tStartMs": 912650,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and that's a whole 'nother story."
    } ]
  }, {
    "tStartMs": 915690,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "That's why I don't flip properties,"
    } ]
  }, {
    "tStartMs": 917210,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "you know, I don't like to do that stuff."
    } ]
  }, {
    "tStartMs": 919350,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So anything else, so good debt, what?"
    } ]
  }, {
    "tStartMs": 922200,
    "dDurationMs": 1347,
    "segs": [ {
      "utf8": "- Money in your pocket."
    } ]
  }, {
    "tStartMs": 923547,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "- And bad debt what?"
    } ]
  }, {
    "tStartMs": 924900,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "- Takes money out of your pocket."
    } ]
  }, {
    "tStartMs": 926240,
    "dDurationMs": 994,
    "segs": [ {
      "utf8": "- That's all there is.\n- Yeah."
    } ]
  }, {
    "tStartMs": 927234,
    "dDurationMs": 989,
    "segs": [ {
      "utf8": "- Thank you."
    } ]
  } ]
}
