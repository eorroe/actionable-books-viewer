    "tStartMs": 518950,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "it puts money in my pocket."
    } ]
  }, {
    "tStartMs": 521210,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "So if I live in the house it's a liability"
