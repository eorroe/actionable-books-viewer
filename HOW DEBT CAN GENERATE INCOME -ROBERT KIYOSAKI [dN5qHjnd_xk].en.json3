{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 476,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 5800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "- Okay I'm here with Alexandra"
    } ]
  }, {
    "tStartMs": 8100,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "and we're doing another Millennial Money."
    } ]
  }, {
    "tStartMs": 12170,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "And very excited about this program"
    } ]
  }, {
    "tStartMs": 14190,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "so thank you for tuning in."
    } ]
  }, {
    "tStartMs": 16050,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "This will be one of 10 and we don't know"
    } ]
  }, {
    "tStartMs": 18170,
    "dDurationMs": 1849,
    "segs": [ {
      "utf8": "which order they're comin' in so."
    } ]
  }, {
    "tStartMs": 20019,
    "dDurationMs": 2063,
    "segs": [ {
      "utf8": "What are some of your\nquestions when people say"
    } ]
  }, {
    "tStartMs": 22082,
    "dDurationMs": 2119,
    "segs": [ {
      "utf8": "get out of debt, what comes to your mind?"
    } ]
  }, {
    "tStartMs": 24201,
    "dDurationMs": 1639,
    "segs": [ {
      "utf8": "- When people say get out\nof debt, I think about"
    } ]
  }, {
    "tStartMs": 25840,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "credit card debt, the student loan debt,"
    } ]
  }, {
    "tStartMs": 29010,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "all that negative debt that people use"
    } ]
  }, {
    "tStartMs": 30890,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "for shopping and personal things."
    } ]
  }, {
    "tStartMs": 32730,
    "dDurationMs": 3108,
    "segs": [ {
      "utf8": "- And is your idea of debt good or bad?"
    } ]
  }, {
    "tStartMs": 35838,
    "dDurationMs": 4112,
    "segs": [ {
      "utf8": "- I have a very negative idea\nor connotation towards debt"
    } ]
  }, {
    "tStartMs": 39950,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "and that's because that's\nwhat we were taught"
    } ]
  }, {
    "tStartMs": 41700,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "in the school system and the\ntraditional education system,"
    } ]
  }, {
    "tStartMs": 44840,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "that it's not so great."
    } ]
  }, {
    "tStartMs": 46260,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "But because I have, I work\nhere and I have these resources"
    } ]
  }, {
    "tStartMs": 49330,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "and I've gone to your seminars,"
    } ]
  }, {
    "tStartMs": 51200,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "I understand that debt can be powerful"
    } ]
  }, {
    "tStartMs": 53470,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "and it can be used in a good way"
    } ]
  }, {
    "tStartMs": 55030,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "and it can generate you money."
    } ]
  }, {
    "tStartMs": 56750,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "- So for those listening, debt is"
    } ]
  }, {
    "tStartMs": 59210,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "a four letter word for most people."
    } ]
  }, {
    "tStartMs": 61670,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "There are many people in my position,"
    } ]
  }, {
    "tStartMs": 63440,
    "dDurationMs": 4893,
    "segs": [ {
      "utf8": "so called financial gurus who\nsay live totally debt free."
    } ]
  }, {
    "tStartMs": 69300,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "And there's other people who\nsay cut up your credit cards."
    } ]
  }, {
    "tStartMs": 72900,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "And you know that's good advice\nfor certain types of people"
    } ]
  }, {
    "tStartMs": 76760,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "so you should definitely\ncut up your credit cards"
    } ]
  }, {
    "tStartMs": 79170,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "if you don't know, you\ncan't control your spending."
    } ]
  }, {
    "tStartMs": 82680,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "You should definitely."
    } ]
  }, {
    "tStartMs": 83860,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "But I don't know how people\nlive without credit cards,"
    } ]
  }, {
    "tStartMs": 85830,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "I don't know how you\ncan check into a hotel,"
    } ]
  }, {
    "tStartMs": 87960,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "rent a car, or go shopping, go\nout for dinner, you know, so."
    } ]
  }, {
    "tStartMs": 92410,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "But you should cut up your credit cards"
    } ]
  }, {
    "tStartMs": 94100,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "if you're a shopaholic,\nthat's good advice."
    } ]
  }, {
    "tStartMs": 98130,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "And the other thing about debt,"
    } ]
  }, {
    "tStartMs": 100300,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "there's good debt and bad debt."
    } ]
  }, {
    "tStartMs": 103350,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "So this is gonna be the lesson today,"
    } ]
  }, {
    "tStartMs": 105050,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "is there's good debt and bad debt."
    } ]
  }, {
    "tStartMs": 106600,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "And if you only have bad debt,"
    } ]
  }, {
    "tStartMs": 109190,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "which I classify student\nloan debt as bad debt."
    } ]
  }, {
    "tStartMs": 112100,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "The main reason it's bad debt is"
    } ]
  }, {
    "tStartMs": 113690,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "because it's the worst\npossible type of debt."
    } ]
  }, {
    "tStartMs": 116740,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "You see if I get into trouble\nas a business man with debt"
    } ]
  }, {
    "tStartMs": 120400,
    "dDurationMs": 2653,
    "segs": [ {
      "utf8": "I can declare bankruptcy and I'm clean."
    } ]
  }, {
    "tStartMs": 124060,
    "dDurationMs": 4210,
    "segs": [ {
      "utf8": "But the trouble with student\nloan debt, you can't do that."
    } ]
  }, {
    "tStartMs": 128270,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "You know, it hangs around your neck"
    } ]
  }, {
    "tStartMs": 129880,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "for the rest of your life."
    } ]
  }, {
    "tStartMs": 132170,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "So if you're a student,\nyou shouldn't take on"
    } ]
  }, {
    "tStartMs": 135970,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "student loan debt unless you\nabsolutely 100% guaranteed"
    } ]
  }, {
    "tStartMs": 140340,
    "dDurationMs": 1823,
    "segs": [ {
      "utf8": "that you will commit to graduating."
    } ]
  }, {
    "tStartMs": 143420,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "Have you seen a lot of\nkids drop out of school?"
    } ]
  }, {
    "tStartMs": 145290,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Oh yeah."
    } ]
  }, {
    "tStartMs": 146123,
    "dDurationMs": 1947,
    "segs": [ {
      "utf8": "- And so the problem\nwith student loan debt"
    } ]
  }, {
    "tStartMs": 148070,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "is a person has to know what\nare they going to study."
    } ]
  }, {
    "tStartMs": 151920,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "- You know I have two friends,\nthey're both medical doctors."
    } ]
  }, {
    "tStartMs": 154830,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "And they came out of school\nwith $500,000 in medical debt,"
    } ]
  }, {
    "tStartMs": 158130,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "I mean in student loan debt."
    } ]
  }, {
    "tStartMs": 159810,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "But they paid it off in five years"
    } ]
  }, {
    "tStartMs": 161960,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "because they're medical doctors."
    } ]
  }, {
    "tStartMs": 163740,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "They had high paying jobs."
    } ]
  }, {
    "tStartMs": 166500,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "And so they delayed having\nfamilies and all this"
    } ]
  }, {
    "tStartMs": 168760,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "and they're whole objective was"
    } ]
  }, {
    "tStartMs": 170640,
    "dDurationMs": 1763,
    "segs": [ {
      "utf8": "to pay for becoming a doctor."
    } ]
  }, {
    "tStartMs": 173250,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "But I think you have friends who have"
    } ]
  }, {
    "tStartMs": 174870,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "no idea what they're going to school for."
    } ]
  }, {
    "tStartMs": 176970,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "- Yes I have this friend\nand she's changed her major"
    } ]
  }, {
    "tStartMs": 179570,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "like three different times,\nfrom business to now nursing"
    } ]
  }, {
    "tStartMs": 182980,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "and it's a lot of money\nand she still has no idea"
    } ]
  }, {
    "tStartMs": 186130,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "what she wants to do and she tells me,"
    } ]
  }, {
    "tStartMs": 187520,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "she's like Alex I want to\nchange my major from Nursing"
    } ]
  }, {
    "tStartMs": 190490,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "but I'm already practically done"
    } ]
  }, {
    "tStartMs": 193640,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "and I can't pay back this debt"
    } ]
  }, {
    "tStartMs": 195760,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "so she's stuck with the nursing career"
    } ]
  }, {
    "tStartMs": 197780,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "and she doesn't even like it."
    } ]
  }, {
    "tStartMs": 198940,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "- You know when I was your age,\nlike I think I said earlier"
    } ]
  }, {
    "tStartMs": 203240,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "is that my classmates were\nmaking like 110, 120,000 a year."
    } ]
  }, {
    "tStartMs": 207050,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Which is not much money,\nbut for my generation"
    } ]
  }, {
    "tStartMs": 210930,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "if I made 20,000 that was a lot of money."
    } ]
  }, {
    "tStartMs": 214210,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "Do you know what I mean?\nIs this out of proportion?"
    } ]
  }, {
    "tStartMs": 216020,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "So we were the highest\npaid graduates in the world"
    } ]
  }, {
    "tStartMs": 219090,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "and my starting pay was\nabout 47,000 a year."
    } ]
  }, {
    "tStartMs": 222260,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "My classmates were making\nthree times as much as me."
    } ]
  }, {
    "tStartMs": 225440,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "But it's a choice we make,"
    } ]
  }, {
    "tStartMs": 226380,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "I didn't really want\nto do what they did so."
    } ]
  }, {
    "tStartMs": 229400,
    "dDurationMs": 1942,
    "segs": [ {
      "utf8": "I had to join a labor union."
    } ]
  }, {
    "tStartMs": 231342,
    "dDurationMs": 3838,
    "segs": [ {
      "utf8": "As ships officers we had to join the MM\u0026P,"
    } ]
  }, {
    "tStartMs": 235180,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "Masters, Mates, and Pilots."
    } ]
  }, {
    "tStartMs": 236630,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Which meant we were labor union guys."
    } ]
  }, {
    "tStartMs": 238650,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "So labor union guys make more money"
    } ]
  }, {
    "tStartMs": 241870,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "and nothing personal but I\ndon't want to be a union member."
    } ]
  }, {
    "tStartMs": 247160,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "So I joined Standard Oil of California"
    } ]
  }, {
    "tStartMs": 249340,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "as a shipping officer and then"
    } ]
  }, {
    "tStartMs": 251430,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "I didn't have to join the labor union."
    } ]
  }, {
    "tStartMs": 253040,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "But I only got 47,000 a year,\nthat was the difference."
    } ]
  }, {
    "tStartMs": 256650,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "The difference is standard\noil was still sailing"
    } ]
  }, {
    "tStartMs": 259330,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and a lot of those labor\nunion jobs are gone"
    } ]
  }, {
    "tStartMs": 261670,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "because the pay got too high."
    } ]
  }, {
    "tStartMs": 263800,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "- You know what I mean, so\nthere's always a good and bad"
    } ]
  }, {
    "tStartMs": 265440,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "and it's hard to understand\nthat when you're younger"
    } ]
  }, {
    "tStartMs": 268570,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "but I knew when I was 22 years old,"
    } ]
  }, {
    "tStartMs": 271390,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "I didn't care if they\npaid me 100,000 a year,"
    } ]
  }, {
    "tStartMs": 273820,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "I wasn't gonna join a union,\nit was just principle."
    } ]
  }, {
    "tStartMs": 276980,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "My father, poor dad, was\nhead of the teacher's union"
    } ]
  }, {
    "tStartMs": 280610,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "and for what I saw (laughs) I\ndidn't want to be a teacher,"
    } ]
  }, {
    "tStartMs": 285140,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "I didn't want to be a union member,"
    } ]
  }, {
    "tStartMs": 286470,
    "dDurationMs": 4393,
    "segs": [ {
      "utf8": "so it was kinda youthful\nexuberance on things."
    } ]
  }, {
    "tStartMs": 292000,
    "dDurationMs": 4312,
    "segs": [ {
      "utf8": "But anyway, today it's\nharder because you don't know"
    } ]
  }, {
    "tStartMs": 296312,
    "dDurationMs": 4418,
    "segs": [ {
      "utf8": "what is this mysterious high paying job."
    } ]
  }, {
    "tStartMs": 300730,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "And even lawyers today\nare having a hard time"
    } ]
  }, {
    "tStartMs": 303150,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "because they don't need that many lawyers"
    } ]
  }, {
    "tStartMs": 305040,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "which is a good thing and\nthere's artificial intelligence"
    } ]
  }, {
    "tStartMs": 309160,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "which is replacing a lot\nof the high end jobs."
    } ]
  }, {
    "tStartMs": 311960,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Like even accountants today,\nthey don't need accountants"
    } ]
  }, {
    "tStartMs": 314780,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "because artificial intelligence can do"
    } ]
  }, {
    "tStartMs": 317240,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "a lot of the work for them."
    } ]
  }, {
    "tStartMs": 319580,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "So that's why for your generation,"
    } ]
  }, {
    "tStartMs": 321060,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "student loan debt I would say is possibly"
    } ]
  }, {
    "tStartMs": 324460,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "one of the most important\nthings you need to decide"
    } ]
  }, {
    "tStartMs": 327280,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "before you take on the debt."
    } ]
  }, {
    "tStartMs": 329640,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Number one are you going to graduate?"
    } ]
  }, {
    "tStartMs": 331100,
    "dDurationMs": 2453,
    "segs": [ {
      "utf8": "And number two what are\nyou going to graduate as?"
    } ]
  }, {
    "tStartMs": 333553,
    "dDurationMs": 947,
    "segs": [ {
      "utf8": "- [Alexandra] Exactly."
    } ]
  }, {
    "tStartMs": 334500,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "- Any comments on that,\nanything you want to talk about?"
    } ]
  }, {
    "tStartMs": 336380,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "- So my dream and passion"
    } ]
  }, {
    "tStartMs": 337480,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "has always been to be an entrepreneur."
    } ]
  }, {
    "tStartMs": 339720,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "But when I started studying it,"
    } ]
  }, {
    "tStartMs": 341020,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I told my dad it was the\nlast thing I would ever do"
    } ]
  }, {
    "tStartMs": 342940,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "because I thought that\nwhat they were teaching me"
    } ]
  }, {
    "tStartMs": 346690,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "was what I was gonna be\ndoing on a day-to-day basis."
    } ]
  }, {
    "tStartMs": 349430,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "But these teachers don't,\naren't actually practicing"
    } ]
  }, {
    "tStartMs": 352560,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "what they're teaching and so they give you"
    } ]
  }, {
    "tStartMs": 354600,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "this wrong conception\nof what you're studying"
