{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 6210,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "- Hello this is Robert\nKiyosaki and we're here"
    } ]
  }, {
    "tStartMs": 8680,
    "dDurationMs": 4614,
    "segs": [ {
      "utf8": "for another exciting and\nimportant and financial education."
    } ]
  }, {
    "tStartMs": 13294,
    "dDurationMs": 4516,
    "segs": [ {
      "utf8": "Money for Millennials, or\nMillennials and Their Money."
    } ]
  }, {
    "tStartMs": 17810,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Cause as you and I know,"
    } ]
  }, {
    "tStartMs": 19410,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "our school teaches us this about money."
    } ]
  }, {
    "tStartMs": 22040,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 22873,
    "dDurationMs": 1227,
    "segs": [ {
      "utf8": "- And it really kinda screws people up,"
    } ]
  }, {
    "tStartMs": 24100,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "because they go out of\nschool and they start doing"
    } ]
  }, {
    "tStartMs": 27560,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "the thing we talked about,"
    } ]
  }, {
    "tStartMs": 28660,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "go to school and get a job, right?"
    } ]
  }, {
    "tStartMs": 31070,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "So that was the first two lessons."
    } ]
  }, {
    "tStartMs": 32700,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "So we have Alexandra here."
    } ]
  }, {
    "tStartMs": 34720,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "She is a daughter of our dear friends"
    } ]
  }, {
    "tStartMs": 37840,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Fernando and Cicilia Gonzalez."
    } ]
  }, {
    "tStartMs": 41170,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "And Alexandra was born"
    } ]
  }, {
    "tStartMs": 42860,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "the same year that rich dad was born."
    } ]
  }, {
    "tStartMs": 44360,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yeah."
    } ]
  }, {
    "tStartMs": 45193,
    "dDurationMs": 1787,
    "segs": [ {
      "utf8": "- And again for those who may not know"
    } ]
  }, {
    "tStartMs": 46980,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "my rich dad was my best friend's father."
    } ]
  }, {
    "tStartMs": 49201,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "My poor dad was an academic\nstraight A student,"
    } ]
  }, {
    "tStartMs": 52300,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I wasn't."
    } ]
  }, {
    "tStartMs": 53890,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "I was a D, F, and C student."
    } ]
  }, {
    "tStartMs": 56050,
    "dDurationMs": 1144,
    "segs": [ {
      "utf8": "On a good day."
    } ]
  }, {
    "tStartMs": 57194,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 58027,
    "dDurationMs": 1723,
    "segs": [ {
      "utf8": "But my rich dad never finished school."
    } ]
  }, {
    "tStartMs": 59750,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "So he had a completely\ndifferent point of view."
    } ]
  }, {
    "tStartMs": 61710,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "It's not right or wrong,"
    } ]
  }, {
    "tStartMs": 63730,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "but rich dad was an entrepreneur,"
    } ]
  }, {
    "tStartMs": 65460,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "and poor dad was a school teacher,"
    } ]
  }, {
    "tStartMs": 67640,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "head of education,"
    } ]
  }, {
    "tStartMs": 68690,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "PhD,"
    } ]
  }, {
    "tStartMs": 69880,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Stanford, University of Chicago,"
    } ]
  }, {
    "tStartMs": 71600,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "all the credentials for academics."
    } ]
  }, {
    "tStartMs": 74010,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "So at the age of nine in Hilo, Hawaii,"
    } ]
  }, {
    "tStartMs": 76000,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "my rich dad starting teaching me."
    } ]
  }, {
    "tStartMs": 77530,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "Cause I asked a question of my teacher,"
    } ]
  }, {
    "tStartMs": 79140,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "my fourth grade teacher,"
    } ]
  }, {
    "tStartMs": 80180,
    "dDurationMs": 1957,
    "segs": [ {
      "utf8": "said, \"When do we learn about money?\""
    } ]
  }, {
    "tStartMs": 82137,
    "dDurationMs": 1973,
    "segs": [ {
      "utf8": "\"Well we don't teach about money.\""
    } ]
  }, {
    "tStartMs": 84110,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "And I thought that was really stupid."
    } ]
  }, {
    "tStartMs": 85770,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "Why go to school, get a job"
    } ]
  }, {
    "tStartMs": 86920,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "but know nothing about money?"
    } ]
  }, {
    "tStartMs": 88680,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "So with that this lesson's\nlesson number one,"
    } ]
  }, {
    "tStartMs": 91170,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and the rich don't work for money."
    } ]
  }, {
    "tStartMs": 92970,
    "dDurationMs": 2173,
    "segs": [ {
      "utf8": "So when I show you that\nwhat goes through your head?"
    } ]
  }, {
    "tStartMs": 95143,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "- Because I already know your philosophy"
    } ]
  }, {
    "tStartMs": 97010,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "it makes a lot of sense to me."
    } ]
  }, {
    "tStartMs": 98277,
    "dDurationMs": 2743,
    "segs": [ {
      "utf8": "- But for somebody watching\nthis for the first time."
    } ]
  }, {
    "tStartMs": 101020,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "It doesn't make sense right?"
    } ]
  }, {
    "tStartMs": 101970,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "- [Alexandra] Yeah it doesn't make sense."
    } ]
  }, {
    "tStartMs": 103140,
    "dDurationMs": 1765,
    "segs": [ {
      "utf8": "- Cause you go to school to get a job"
    } ]
  }, {
    "tStartMs": 104905,
    "dDurationMs": 995,
    "segs": [ {
      "utf8": "so you can work for money."
    } ]
  }, {
    "tStartMs": 105900,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- [Alexandra] That's the\npurpose of life, yeah."
    } ]
  }, {
    "tStartMs": 107370,
    "dDurationMs": 963,
    "segs": [ {
      "utf8": "- Right, right."
    } ]
  }, {
    "tStartMs": 109170,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "To be a slave for money."
    } ]
  }, {
    "tStartMs": 110190,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Exactly."
    } ]
  }, {
    "tStartMs": 111023,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- And work for idiots like me."
    } ]
  }, {
    "tStartMs": 111856,
    "dDurationMs": 1194,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 113050,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "- [Alexandra] Exactly."
    } ]
  }, {
    "tStartMs": 114660,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- But anyway my way of\nteaching is to first put doubt"
    } ]
  }, {
    "tStartMs": 120790,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "in your brain."
    } ]
  }, {
    "tStartMs": 122160,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "To challenge your belief systems."
    } ]
  }, {
    "tStartMs": 124910,
    "dDurationMs": 3347,
    "segs": [ {
      "utf8": "And then maybe you can choose new beliefs,"
    } ]
  }, {
    "tStartMs": 128257,
    "dDurationMs": 2176,
    "segs": [ {
      "utf8": "or keep up with old beliefs."
    } ]
  }, {
    "tStartMs": 131640,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "So when you think about working for money,"
    } ]
  }, {
    "tStartMs": 133340,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "what comes through your head?"
    } ]
  }, {
    "tStartMs": 134600,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "- I think about the time\nthat I worked at the bank"
    } ]
  }, {
    "tStartMs": 137040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and I was working paycheck to paycheck."
    } ]
  }, {
    "tStartMs": 139200,
    "dDurationMs": 2187,
    "segs": [ {
      "utf8": "And I wasn't exposed to\nthe financial education"
    } ]
  }, {
    "tStartMs": 141387,
    "dDurationMs": 1843,
    "segs": [ {
      "utf8": "that you provide me with."
    } ]
  }, {
    "tStartMs": 143230,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "It was kind of sad that I\ncouldn't afford the things"
    } ]
  }, {
    "tStartMs": 147240,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "that I wanted to do,"
    } ]
  }, {
    "tStartMs": 148550,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "and I was just in this\ncycle of paying my bills,"
    } ]
  }, {
    "tStartMs": 152700,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and going to work and that's it."
    } ]
  }, {
    "tStartMs": 154530,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "- Do you have friends who\nhaven't found the good job,"
    } ]
  }, {
    "tStartMs": 157660,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "even though they went to school."
    } ]
  }, {
    "tStartMs": 159160,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "- So I have many friends\nthat have graduated"
    } ]
  }, {
    "tStartMs": 162120,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "and they're told that\nthey're gonna go to school,"
    } ]
  }, {
    "tStartMs": 164700,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "and they're gonna find a job,"
    } ]
  }, {
    "tStartMs": 166220,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and they find themselves without anything."
    } ]
  }, {
    "tStartMs": 168500,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "So many of them have found jobs,"
    } ]
  }, {
    "tStartMs": 171170,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and many of them have\nhave also not found a job."
    } ]
  }, {
    "tStartMs": 174110,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "- The irony of when I\nleft school in the '60s,"
    } ]
  }, {
    "tStartMs": 177420,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "there was plenty of jobs."
    } ]
  }, {
    "tStartMs": 179610,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But the world has changed."
    } ]
  }, {
    "tStartMs": 181290,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "And our schools haven't."
    } ]
  }, {
    "tStartMs": 183080,
    "dDurationMs": 2518,
    "segs": [ {
      "utf8": "And they're still making\nthis innate promise of"
    } ]
  }, {
    "tStartMs": 185598,
    "dDurationMs": 1742,
    "segs": [ {
      "utf8": "get a job."
    } ]
  }, {
    "tStartMs": 187340,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "And I was very fortunate\nwhen I graduated in '69,"
    } ]
  }, {
    "tStartMs": 189850,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "we're the highest paid\ngraduates in the world."
    } ]
  }, {
    "tStartMs": 191720,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "My classmates were making\nabout $120,000 to $150,000"
    } ]
  }, {
    "tStartMs": 194410,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "a year."
    } ]
  }, {
    "tStartMs": 195270,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "That's not much money today,"
    } ]
  }, {
    "tStartMs": 197490,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "but 1969 that was a lot of money."
    } ]
  }, {
    "tStartMs": 201930,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "But naturally as young guys do,"
    } ]
  }, {
    "tStartMs": 203950,
    "dDurationMs": 1213,
    "segs": [ {
      "utf8": "we spent every penny of it."
    } ]
  }, {
    "tStartMs": 205163,
    "dDurationMs": 2897,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 208060,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So I had my rich dad's lesson,"
    } ]
  }, {
    "tStartMs": 209890,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "the rich don't work for money,"
    } ]
  }, {
    "tStartMs": 211150,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "in my head."
    } ]
  }, {
    "tStartMs": 211983,
    "dDurationMs": 3247,
    "segs": [ {
      "utf8": "I said, \"Okay I'm making all this money,"
    } ]
  }, {
    "tStartMs": 215230,
    "dDurationMs": 1573,
    "segs": [ {
      "utf8": "I have a secure job,"
    } ]
  }, {
    "tStartMs": 217750,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "but what's beyond that?\""
    } ]
  }, {
    "tStartMs": 218990,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And that's where education comes in."
    } ]
  }, {
    "tStartMs": 221470,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "So if I could explain this\nto you for the rest of"
    } ]
  }, {
    "tStartMs": 224100,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "the millennial lessons,"
    } ]
  }, {
    "tStartMs": 225430,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "it's really gonna be on this theme here."
    } ]
  }, {
    "tStartMs": 227960,
    "dDurationMs": 3383,
    "segs": [ {
      "utf8": "Because financial education is\nabout not working for money."
    } ]
  }, {
    "tStartMs": 232260,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Like one of the first questions,"
    } ]
  }, {
    "tStartMs": 233900,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "when I finally realized\nwhat my rich dad was saying,"
    } ]
  }, {
    "tStartMs": 236940,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "I said, \"well when do I\nnever need a paycheck again?\""
    } ]
  }, {
    "tStartMs": 240260,
    "dDurationMs": 3763,
    "segs": [ {
      "utf8": "See my goal wasn't go to the moon,"
    } ]
  }, {
    "tStartMs": 244974,
    "dDurationMs": 1236,
    "segs": [ {
      "utf8": "or cure cancer,"
    } ]
  }, {
    "tStartMs": 246210,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "my job was when would I\nnever need a paycheck again?"
    } ]
  }, {
    "tStartMs": 250390,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "Because as long as you need a paycheck,"
    } ]
  }, {
    "tStartMs": 252720,
    "dDurationMs": 2575,
    "segs": [ {
      "utf8": "be it from an employer\nor like my poor dad,"
    } ]
  }, {
    "tStartMs": 255295,
    "dDurationMs": 3658,
    "segs": [ {
      "utf8": "he was so afraid of losing\nhis government pension."
    } ]
  }, {
    "tStartMs": 260240,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "And I'm going \"Jesus what\na way to run your life.\""
    } ]
  }, {
    "tStartMs": 262680,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Your pension?"
    } ]
  }, {
    "tStartMs": 264160,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "So my old man kinda got fired,"
    } ]
  }, {
    "tStartMs": 266550,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "he lost his pension."
    } ]
  }, {
    "tStartMs": 268250,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "It was the most frightening\nthing in the world to him."
    } ]
  }, {
    "tStartMs": 270340,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "He had no pension."
    } ]
  }, {
    "tStartMs": 271970,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "Then it was social security,"
    } ]
  }, {
    "tStartMs": 273360,
    "dDurationMs": 1703,
    "segs": [ {
      "utf8": "which is even worse."
    } ]
  }, {
    "tStartMs": 276610,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "So that's why my goal\nwhen I was about your age,"
    } ]
  }, {
    "tStartMs": 279560,
    "dDurationMs": 2513,
    "segs": [ {
      "utf8": "a little older around 25 I said,"
    } ]
  }, {
    "tStartMs": 283017,
    "dDurationMs": 2513,
    "segs": [ {
      "utf8": "\"My goal is to never\nneed a paycheck again,"
    } ]
  }, {
    "tStartMs": 285530,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "from anybody, even the government,"
    } ]
  }, {
    "tStartMs": 288270,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "I don't want any\nMedicare, social security,"
    } ]
  }, {
    "tStartMs": 291530,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "or whatever.\""
    } ]
  }, {
    "tStartMs": 292660,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Well I was a military pilot,"
    } ]
  }, {
    "tStartMs": 293940,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "so, \"Oh you gotta get the\nmilitary pilot pension.\""
    } ]
  }, {
    "tStartMs": 297170,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "I said, \"You do, but I'm not going to.\""
    } ]
  }, {
    "tStartMs": 299830,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And just because of this here."
    } ]
  }, {
    "tStartMs": 302170,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "That was the difference."
    } ]
  }, {
    "tStartMs": 303580,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "Cause I never wanted to work for money"
    } ]
  }, {
    "tStartMs": 306450,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to need a paycheck."
    } ]
  }, {
    "tStartMs": 308370,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "So the next few lessons\nin Millennial Money,"
    } ]
  }, {
    "tStartMs": 310610,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "you'll find out what I do work for."
    } ]
  }, {
    "tStartMs": 313180,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "So for right now let me\ngo to the lesson here."
    } ]
  }, {
    "tStartMs": 319880,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "So this comes from rich dad poor dad."
    } ]
  }, {
    "tStartMs": 321810,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "And these are some of the distinctions."
    } ]
  }, {
    "tStartMs": 326506,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "It was the advantage I had at age nine,"
    } ]
  }, {
    "tStartMs": 328240,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "cause I knew what I wanted to work for."
    } ]
  }, {
    "tStartMs": 332000,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "And this here in simple terms is called"
    } ]
  }, {
    "tStartMs": 334070,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "a financial statement."
    } ]
  }, {
    "tStartMs": 335520,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "In school they teach\nyou to get a FICO score."
    } ]
  }, {
    "tStartMs": 337930,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "FICO is BS."
    } ]
  }, {
    "tStartMs": 339760,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "All that means,"
    } ]
  }, {
    "tStartMs": 340593,
    "dDurationMs": 1137,
    "segs": [ {
      "utf8": "how good are you paying your bills?"
    } ]
  }, {
    "tStartMs": 341730,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "That's all FICO means."
    } ]
  }, {
    "tStartMs": 343500,
    "dDurationMs": 1328,
    "segs": [ {
      "utf8": "Should be the Fido score."
    } ]
  }, {
    "tStartMs": 344828,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 345661,
    "dDurationMs": 1369,
    "segs": [ {
      "utf8": "Good dog."
    } ]
  }, {
    "tStartMs": 347030,
    "dDurationMs": 2293,
    "segs": [ {
      "utf8": "So this is what your banker wants to see."
    } ]
  }, {
    "tStartMs": 357570,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "When I was nine years old playing Monopoly"
    } ]
  }, {
    "tStartMs": 360300,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "with my rich dad,"
    } ]
  }, {
    "tStartMs": 361133,
    "dDurationMs": 2747,
    "segs": [ {
      "utf8": "this was the lesson that's\nnot included in Monopoly,"
    } ]
  }, {
    "tStartMs": 363880,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "but rich dad taught me."
    } ]
  }, {
    "tStartMs": 366020,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And fundamentally the problem\nthat most people make,"
    } ]
  }, {
    "tStartMs": 371230,
    "dDurationMs": 2453,
    "segs": [ {
      "utf8": "they go to school to get a job,"
    } ]
  }, {
    "tStartMs": 374760,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and they work here."
    } ]
  }, {
    "tStartMs": 375960,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "So this is the poor middle\nclass and these guys."
    } ]
  }, {
    "tStartMs": 379100,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "And we're gonna talk about later"
    } ]
  }, {
    "tStartMs": 380470,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "your first line on an expense is taxes."
    } ]
  }, {
    "tStartMs": 384460,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "You know just recently\nPresident Trump said he'd get"
    } ]
  }, {
    "tStartMs": 387240,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "a tax cut."
    } ]
  }, {
    "tStartMs": 389090,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "He didn't have a tax cut for these guys."
    } ]
  }, {
    "tStartMs": 391760,
    "dDurationMs": 2873,
    "segs": [ {
      "utf8": "As you know the rules are\nalways written for the rich."
    } ]
  }, {
    "tStartMs": 395497,
    "dDurationMs": 1343,
    "segs": [ {
      "utf8": "I didn't make the rules."
    } ]
  }, {
    "tStartMs": 396840,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "You can get angry at me,"
    } ]
  }, {
    "tStartMs": 398410,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "but these are the rules."
    } ]
  }, {
    "tStartMs": 399820,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "The rich make the rules."
    } ]
  }, {
    "tStartMs": 401270,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "The Golden Rule."
    } ]
  }, {
    "tStartMs": 402130,
    "dDurationMs": 2944,
    "segs": [ {
      "utf8": "He who has the gold makes the rules."
    } ]
  }, {
    "tStartMs": 405074,
    "dDurationMs": 1456,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 406530,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "So the tax cut went to people here."
    } ]
  }, {
    "tStartMs": 409140,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "That's where it goes to,"
    } ]
  }, {
    "tStartMs": 409980,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "you'll learn more about this later on."
    } ]
  }, {
    "tStartMs": 412110,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "But this is what I work for."
    } ]
  }, {
    "tStartMs": 414670,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So what I work for number one is"
    } ]
  }, {
    "tStartMs": 417790,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "I'm an entrepreneur,"
    } ]
  }, {
    "tStartMs": 418680,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "I want businesses, I\nhave multiple businesses."
    } ]
  }, {
    "tStartMs": 421790,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "And I don't work as you\nknow because you work here,"
    } ]
  }, {
    "tStartMs": 423980,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "you never see me do you?"
    } ]
  }, {
    "tStartMs": 424813,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- No."
    } ]
  }, {
    "tStartMs": 426560,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "- Because I don't work for a paycheck."
    } ]
  }, {
    "tStartMs": 427910,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "- [Alexandra] Exactly."
    } ]
  }, {
    "tStartMs": 428840,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "- Next is real estate."
    } ]
  }, {
    "tStartMs": 430610,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "And real estate is good for many things"
    } ]
  }, {
    "tStartMs": 433300,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "which we'll go into,"
    } ]
  }, {
    "tStartMs": 434133,
    "dDurationMs": 1157,
    "segs": [ {
      "utf8": "but number one is debt."
    } ]
  }, {
    "tStartMs": 435290,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "I use a lot of debt to buy real estate,"
    } ]
  }, {
    "tStartMs": 437750,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "and I pay no taxes."
    } ]
  }, {
    "tStartMs": 439000,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "That's the relationship there."
    } ]
  }, {
    "tStartMs": 440830,
    "dDurationMs": 1253,
    "segs": [ {
      "utf8": "The next is paper."
    } ]
  }, {
    "tStartMs": 444030,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "And that's savings, stocks, bonds,"
    } ]
  }, {
    "tStartMs": 445820,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "mutual funds, ETFs, and that stuff."
    } ]
  }, {
    "tStartMs": 447840,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "I don't have any of that stuff."
    } ]
  }, {
    "tStartMs": 449150,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "I don't save money,"
    } ]
  }, {
    "tStartMs": 450200,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I don't have any of that."
    } ]
  }, {
    "tStartMs": 451700,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "But this is what most people have,"
    } ]
  }, {
    "tStartMs": 453460,
    "dDurationMs": 1453,
    "segs": [ {
      "utf8": "go to school get a job,"
    } ]
  }, {
    "tStartMs": 456090,
    "dDurationMs": 2655,
    "segs": [ {
      "utf8": "get a 401K and save money."
    } ]
  }, {
    "tStartMs": 458745,
    "dDurationMs": 1426,
    "segs": [ {
      "utf8": "Loser."
    } ]
  }, {
    "tStartMs": 460171,
    "dDurationMs": 869,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 461040,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I'm doing that just to upset you guys."
    } ]
  }, {
    "tStartMs": 463140,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "Cause maybe you'll start to think."
    } ]
  }, {
    "tStartMs": 465010,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "Cause I didn't make the rules,"
    } ]
  }, {
    "tStartMs": 466170,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "I'm just telling you these are the rules."
    } ]
  }, {
    "tStartMs": 468030,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "These people pay the highest taxes."
    } ]
  }, {
    "tStartMs": 471110,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "And they work the hardest."
    } ]
  }, {
    "tStartMs": 472710,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And the last are commodities\nfor different assets classes."
    } ]
  }, {
    "tStartMs": 478850,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "So commodities are,"
    } ]
  }, {
    "tStartMs": 480250,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "number one is gold, silver, oil,"
    } ]
  }, {
    "tStartMs": 484150,
    "dDurationMs": 2473,
    "segs": [ {
      "utf8": "land, water, food."
    } ]
  }, {
    "tStartMs": 487910,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "So this is what I work for."
    } ]
  }, {
    "tStartMs": 489610,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "When I left school,"
    } ]
  }, {
    "tStartMs": 490580,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "rather than working for a paycheck,"
    } ]
  }, {
    "tStartMs": 493210,
    "dDurationMs": 1243,
    "segs": [ {
      "utf8": "and working for money,"
    } ]
  }, {
    "tStartMs": 496150,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "my education had to go\nbeyond getting a job."
    } ]
  }, {
    "tStartMs": 498950,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "Which I had a good job,"
    } ]
  }, {
    "tStartMs": 501720,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "but I now had to start when I left school,"
    } ]
  }, {
    "tStartMs": 504070,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "about your age,"
    } ]
  }, {
    "tStartMs": 505810,
    "dDurationMs": 3983,
    "segs": [ {
      "utf8": "the thing I focused on first\nactually was commodities."
    } ]
  }, {
    "tStartMs": 510780,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "So back in 1972 I started buying gold."
    } ]
  }, {
    "tStartMs": 515690,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "And it was illegal for\nAmericans to own gold,"
    } ]
  }, {
    "tStartMs": 517960,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "can you imagine that?"
    } ]
  }, {
    "tStartMs": 520170,
    "dDurationMs": 1123,
    "segs": [ {
      "utf8": "Back in '72."
    } ]
  }, {
    "tStartMs": 522270,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Today you have Bitcoin,"
    } ]
  }, {
    "tStartMs": 523630,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "it's different."
    } ]
  }, {
    "tStartMs": 524930,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Everything is changing so rapidly today."
    } ]
  }, {
    "tStartMs": 527660,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "So I started with gold,"
    } ]
  }, {
    "tStartMs": 529720,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "but actually the next\nthing was actually oil."
    } ]
  }, {
    "tStartMs": 532410,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Because I went to school\nto be a tanker officer,"
    } ]
  }, {
    "tStartMs": 535210,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "driving ships for Standard Oil."
    } ]
  }, {
    "tStartMs": 537570,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So understand oil if I own,"
    } ]
  }, {
    "tStartMs": 539400,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "my wife and I don't own Standard Oil"
    } ]
  }, {
    "tStartMs": 541420,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "or Chevron or Exon."
    } ]
  }, {
    "tStartMs": 544250,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "We own oil wells."
    } ]
  }, {
    "tStartMs": 546270,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "Again taxes."
    } ]
  }, {
    "tStartMs": 548620,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "You get no tax breaks\nfor owning paper oil,"
    } ]
  }, {
    "tStartMs": 551680,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "huge tax breaks for owning real oil."
    } ]
  }, {
    "tStartMs": 556160,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "And then I went into real estate."
    } ]
  }, {
    "tStartMs": 559390,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Why?"
    } ]
  }, {
    "tStartMs": 560223,
    "dDurationMs": 3017,
    "segs": [ {
      "utf8": "Because I can use debt to buy real estate."
    } ]
  }, {
    "tStartMs": 563240,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "And because I use debt,"
    } ]
  }, {
    "tStartMs": 565600,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "I pay no taxes."
    } ]
  }, {
    "tStartMs": 568320,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "And then third I started my business,"
    } ]
  }, {
    "tStartMs": 570920,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "my first real real business."
    } ]
  }, {
    "tStartMs": 572900,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "I had many many businesses as a kid."
    } ]
  }, {
    "tStartMs": 575210,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "But my first real business\nwas a nylon and velcro"
    } ]
  }, {
    "tStartMs": 577780,
    "dDurationMs": 1153,
    "segs": [ {
      "utf8": "surfer wallet business."
    } ]
  }, {
    "tStartMs": 579972,
    "dDurationMs": 1838,
    "segs": [ {
      "utf8": "I went worldwide right away,"
    } ]
  }, {
    "tStartMs": 581810,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "the trouble is I was an idiot"
    } ]
  }, {
    "tStartMs": 584270,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and the business went up"
    } ]
  }, {
    "tStartMs": 585870,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "and the business came down."
    } ]
  }, {
    "tStartMs": 587760,
    "dDurationMs": 2063,
    "segs": [ {
      "utf8": "What kept me alive was this and this."
    } ]
  }, {
    "tStartMs": 591940,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "So you may say well aren't\nyou working for money,"
    } ]
  }, {
    "tStartMs": 593710,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "but we'll go into that next."
    } ]
  }, {
    "tStartMs": 595440,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "I don't want what's called"
    } ]
  }, {
    "tStartMs": 600410,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "a paycheck."
    } ]
  }, {
    "tStartMs": 602410,
    "dDurationMs": 1813,
    "segs": [ {
      "utf8": "I want cash flow,"
    } ]
  }, {
    "tStartMs": 609440,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "from here."
    } ]
  }, {
    "tStartMs": 611090,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "So that's what I mean by the\nrich don't work for money."
    } ]
  }, {
    "tStartMs": 614800,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "You want cash flow that\npays very little taxes,"
    } ]
  }, {
    "tStartMs": 618720,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "and I can use lots of debt over here."
    } ]
  }, {
    "tStartMs": 620810,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "The average person went to school,"
    } ]
  }, {
    "tStartMs": 623090,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "their biggest liability they have"
    } ]
  }, {
    "tStartMs": 624540,
    "dDurationMs": 1163,
    "segs": [ {
      "utf8": "is student loans of course."
    } ]
  }, {
    "tStartMs": 625703,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 626536,
    "dDurationMs": 1527,
    "segs": [ {
      "utf8": "- Yeah of course, definitely."
    } ]
  }, {
    "tStartMs": 628970,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "- I mean it's horrible what\nthey do to you guys today."
    } ]
  }, {
    "tStartMs": 631900,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "A student loan was just the\nworst type of debt of all"
    } ]
  }, {
    "tStartMs": 633643,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "because you cannot\ndeclare bankruptcy on it."
    } ]
  }, {
    "tStartMs": 637280,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Then you get and you try to buy a house,"
    } ]
  }, {
    "tStartMs": 639320,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and you call it an asset\nwhen it's really a liability."
    } ]
  }, {
    "tStartMs": 642120,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Why?"
    } ]
  }, {
    "tStartMs": 642953,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "Because the cash if flowing that way."
    } ]
  }, {
    "tStartMs": 645890,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Your house costs you money every..."
    } ]
  }, {
    "tStartMs": 647630,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "You rent a house it's\nall costing you money."
    } ]
  }, {
    "tStartMs": 651140,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "Then you have to have a nice car,"
    } ]
  }, {
    "tStartMs": 652890,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "I had one of those... this."
    } ]
  }, {
    "tStartMs": 656920,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "So the problem with most young\npeople is they go to school"
    } ]
  }, {
    "tStartMs": 660240,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "to get that job,"
    } ]
  }, {
    "tStartMs": 662140,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "then a lot of them has student loan debt."
    } ]
  }, {
    "tStartMs": 665040,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Then they try to get\nmarried and buy a house,"
    } ]
  }, {
    "tStartMs": 667040,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "have a car,"
    } ]
  }, {
    "tStartMs": 668650,
    "dDurationMs": 1823,
    "segs": [ {
      "utf8": "and then they have credit card debt."
    } ]
  }, {
    "tStartMs": 671950,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "But they never have the\nchance to come over here."
    } ]
  }, {
    "tStartMs": 674030,
    "dDurationMs": 3653,
    "segs": [ {
      "utf8": "If they do any investing\nin America it's a 401K,"
    } ]
  }, {
    "tStartMs": 678560,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "which I wouldn't touch\nwith a 10 foot pole."
    } ]
  }, {
    "tStartMs": 680450,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Now you should,"
    } ]
  }, {
    "tStartMs": 681740,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "but I don't cause I don't have to."
    } ]
  }, {
    "tStartMs": 684220,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Cause I went to school for here,"
    } ]
  }, {
    "tStartMs": 686890,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and people who don't go\nto school should be here."
    } ]
  }, {
    "tStartMs": 689830,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "This is a 401K, IRA, ETFs and that stuff."
    } ]
  }, {
    "tStartMs": 693640,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "Paper."
    } ]
  }, {
    "tStartMs": 694950,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Savings."
    } ]
  }, {
    "tStartMs": 695783,
    "dDurationMs": 897,
    "segs": [ {
      "utf8": "I don't touch that stuff."
    } ]
  }, {
    "tStartMs": 696680,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "And we'll go into that later on."
    } ]
  }, {
    "tStartMs": 699620,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "So when I say the rich\ndon't work for money,"
    } ]
  }, {
    "tStartMs": 701550,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "I never want to be\ndependent on a paycheck,"
    } ]
  }, {
    "tStartMs": 703590,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "either from an employer or the government."
    } ]
  }, {
    "tStartMs": 706940,
    "dDurationMs": 1765,
    "segs": [ {
      "utf8": "I want to be a free human being."
    } ]
  }, {
    "tStartMs": 708705,
    "dDurationMs": 1575,
    "segs": [ {
      "utf8": "Any comments any questions on this?"
    } ]
  }, {
    "tStartMs": 710280,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "- Well now I see it clearly\nbecause it's ironic how"
    } ]
  }, {
    "tStartMs": 712950,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "people were upset about\nTrump not paying taxes,"
    } ]
  }, {
    "tStartMs": 716610,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "but in reality he would\nhave to be a complete idiot"
    } ]
  }, {
    "tStartMs": 718590,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "if he paid taxes especially\nwhen you were talking about"
    } ]
  }, {
    "tStartMs": 721440,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "your assets and how the government"
    } ]
  }, {
    "tStartMs": 724000,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "wants you to have these things."
    } ]
  }, {
    "tStartMs": 725470,
    "dDurationMs": 3536,
    "segs": [ {
      "utf8": "They want you to own homes\nand invest in properties."
    } ]
  }, {
    "tStartMs": 729006,
    "dDurationMs": 1754,
    "segs": [ {
      "utf8": "That's exactly what Trump was doing,"
    } ]
  }, {
    "tStartMs": 730760,
    "dDurationMs": 1878,
    "segs": [ {
      "utf8": "and so he gets all the\ntax benefits from it."
    } ]
  }, {
    "tStartMs": 732638,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Correct."
    } ]
  }, {
    "tStartMs": 733471,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "- So many people come\nto this country because"
    } ]
  }, {
    "tStartMs": 734930,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "they want to live the American Dream,"
    } ]
  }, {
    "tStartMs": 736360,
    "dDurationMs": 1558,
    "segs": [ {
      "utf8": "of buying their house,"
    } ]
  }, {
    "tStartMs": 737918,
    "dDurationMs": 3292,
    "segs": [ {
      "utf8": "going to a job working\npaycheck to paycheck,"
    } ]
  }, {
    "tStartMs": 741210,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "goin to school,"
    } ]
  }, {
    "tStartMs": 742260,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "when in reality that's a nightmare."
    } ]
  }, {
    "tStartMs": 743770,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "- And what happens if they lose their job."
    } ]
  }, {
    "tStartMs": 745240,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "- They lose all security\nthey were promised"
    } ]
  }, {
    "tStartMs": 747480,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and they lose everything."
    } ]
  }, {
    "tStartMs": 748980,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "And they don't have anything"
    } ]
  }, {
    "tStartMs": 750140,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "to provide for their family either."
    } ]
  }, {
    "tStartMs": 751690,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "- So what does your brain,"
    } ]
  }, {
    "tStartMs": 752900,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "I mean you're a very smart young lady,"
    } ]
  }, {
    "tStartMs": 755420,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "but now your brain is a think right?"
    } ]
  }, {
    "tStartMs": 757080,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "- [Alexandra] Yeah."
    } ]
  }, {
    "tStartMs": 758320,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "- So the question is when I talk to people"
    } ]
  }, {
    "tStartMs": 760110,
    "dDurationMs": 1926,
    "segs": [ {
      "utf8": "about financial education,"
    } ]
  }, {
    "tStartMs": 762036,
    "dDurationMs": 3894,
    "segs": [ {
      "utf8": "well right now we're gonna talk\nabout there's another issue"
    } ]
  }, {
    "tStartMs": 765930,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "is Bitcoin, the dollar and gold."
    } ]
  }, {
    "tStartMs": 770050,
    "dDurationMs": 1093,
    "segs": [ {
      "utf8": "Which one is better?"
    } ]
  }, {
    "tStartMs": 773400,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "I love real estate\nagain because it's debt."
    } ]
  }, {
    "tStartMs": 776220,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "I use debt to buy real estate."
    } ]
  }, {
    "tStartMs": 778780,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "And everybody else is\nsaying get out of debt."
    } ]
  }, {
    "tStartMs": 780448,
    "dDurationMs": 1462,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 781910,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I love debt."
    } ]
  }, {
    "tStartMs": 782743,
    "dDurationMs": 2307,
    "segs": [ {
      "utf8": "Trump loves debt he's the king of debt."
    } ]
  }, {
    "tStartMs": 785050,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "I'm in debt about $600 million."
    } ]
  }, {
    "tStartMs": 787950,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The average person cannot pay\nfor their credit card debt."
    } ]
  }, {
    "tStartMs": 790110,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Alexandra] Wow."
    } ]
  }, {
    "tStartMs": 790943,
    "dDurationMs": 1107,
    "segs": [ {
      "utf8": "- That's how tragic it is."
    } ]
  }, {
    "tStartMs": 792050,
    "dDurationMs": 2183,
    "segs": [ {
      "utf8": "And I'm talking about educated people."
    } ]
  }, {
    "tStartMs": 795420,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "And then this here I get tax breaks"
    } ]
  }, {
    "tStartMs": 797310,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "because I have employees."
    } ]
  }, {
    "tStartMs": 799770,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "This'll be another subject going\ndown with Millennial Money."
    } ]
  }, {
    "tStartMs": 803810,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "But if you have a job you're taxed,"
    } ]
  }, {
    "tStartMs": 806510,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "if you hire employees\nthey give you tax breaks."
    } ]
  }, {
    "tStartMs": 810270,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Look at right now Amazon\nis looking for a new home."
    } ]
  }, {
    "tStartMs": 813480,
    "dDurationMs": 3327,
    "segs": [ {
      "utf8": "Every government wants\nto give them a home."
    } ]
  }, {
    "tStartMs": 816807,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "\"Please move to Indiana.\nPlease move to Canada.\""
    } ]
  }, {
    "tStartMs": 819174,
    "dDurationMs": 1256,
    "segs": [ {
      "utf8": "Why?"
    } ]
  }, {
    "tStartMs": 820430,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "Cause they'll bring in employees,"
    } ]
  }, {
    "tStartMs": 822180,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and employees pay the tax."
    } ]
  }, {
    "tStartMs": 824580,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "It's the same as Tesla."
    } ]
  }, {
    "tStartMs": 825760,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "They got I think $50 billion\nfrom the state of Nevada."
    } ]
  }, {
    "tStartMs": 829490,
    "dDurationMs": 1903,
    "segs": [ {
      "utf8": "Cause they bring in employees."
    } ]
  }, {
    "tStartMs": 832460,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So that's why when your\nteacher says to you"
    } ]
  }, {
    "tStartMs": 834140,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "go to school get a job,"
    } ]
  }, {
    "tStartMs": 835280,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "you say, \"I think I'll\nthink a little bit different"
    } ]
  }, {
    "tStartMs": 837761,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "this time.\""
    } ]
  }, {
    "tStartMs": 838594,
    "dDurationMs": 1406,
    "segs": [ {
      "utf8": "Now you need a job in interim."
    } ]
  }, {
    "tStartMs": 840840,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But you want a job for the experience."
    } ]
  }, {
    "tStartMs": 843270,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "That's the difference."
    } ]
  }, {
    "tStartMs": 845090,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "So the reason rich dad's\nlesson number one is"
    } ]
  }, {
    "tStartMs": 847910,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "rich don't work for money,"
    } ]
  }, {
    "tStartMs": 849790,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "is I never want a paycheck,"
    } ]
  }, {
    "tStartMs": 851760,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "I wanna use debt,"
    } ]
  }, {
    "tStartMs": 853510,
    "dDurationMs": 1385,
    "segs": [ {
      "utf8": "and I don't wanna pay tax,"
    } ]
  }, {
    "tStartMs": 854895,
    "dDurationMs": 3415,
    "segs": [ {
      "utf8": "I pay some tax but minimum tax."
    } ]
  }, {
    "tStartMs": 858310,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "But I wanna accumulate\nthis so I have cash flow."
    } ]
  }, {
    "tStartMs": 862370,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Anything you wanna say,\nany questions on that?"
    } ]
  }, {
    "tStartMs": 864310,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "- No, I'm happy because\nI can see both sides."
    } ]
  }, {
    "tStartMs": 867060,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "I do see the employee's side,"
    } ]
  }, {
    "tStartMs": 868410,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "and the entrepreneur's side."
    } ]
  }, {
    "tStartMs": 870060,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "And thankfully because\nI work in this company,"
    } ]
  }, {
    "tStartMs": 872790,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I'm not forced to work a\nregular nine to five job."
    } ]
  }, {
    "tStartMs": 879200,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "I'm able to actually\nwork on my own projects,"
    } ]
  }, {
    "tStartMs": 881620,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and it's incentivized that we"
    } ]
  }, {
    "tStartMs": 883380,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "actually do become entrepreneurs."
    } ]
  }, {
    "tStartMs": 885330,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "- Our company encourages\neverybody to come here."
    } ]
  }, {
    "tStartMs": 888400,
    "dDurationMs": 1274,
    "segs": [ {
      "utf8": "So we don't have a 401K do we?"
    } ]
  }, {
    "tStartMs": 889674,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 890740,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Alexandra] No."
    } ]
  }, {
    "tStartMs": 891573,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- We don't have a\nretirement plan here do you?"
    } ]
  }, {
    "tStartMs": 892406,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Alexandra] No."
    } ]
  }, {
    "tStartMs": 893239,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Keeps you motivated right?"
    } ]
  }, {
    "tStartMs": 894072,
    "dDurationMs": 1988,
    "segs": [ {
      "utf8": "- [Alexandra] Yeah it does, it does."
    } ]
  }, {
    "tStartMs": 896060,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "- So what would you say to\nyour friends or your fellow"
    } ]
  }, {
    "tStartMs": 899070,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "millennials about why the\nrich don't work for money?"
    } ]
  }, {
    "tStartMs": 902500,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "- I would tell that they truly\nneed to educate themselves"
    } ]
  }, {
    "tStartMs": 905360,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "because to work for money\nis completely ridiculous."
    } ]
  }, {
    "tStartMs": 907980,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "While taxes are increasing,"
    } ]
  }, {
    "tStartMs": 909960,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "and the inflation is increasing,"
    } ]
  }, {
    "tStartMs": 912470,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "it doesn't make any sense to be working"
    } ]
  }, {
    "tStartMs": 914460,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "from paycheck to paycheck."
    } ]
  }, {
    "tStartMs": 915970,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "The rich don't work for money."
    } ]
  }, {
    "tStartMs": 917120,
    "dDurationMs": 1448,
    "segs": [ {
      "utf8": "Money works for them."
    } ]
  }, {
    "tStartMs": 918568,
    "dDurationMs": 1559,
    "segs": [ {
      "utf8": "- Or being afraid of being fired."
    } ]
  }, {
    "tStartMs": 920127,
    "dDurationMs": 2526,
    "segs": [ {
      "utf8": "Or losing your pension."
    } ]
  }, {
    "tStartMs": 922653,
    "dDurationMs": 2637,
    "segs": [ {
      "utf8": "Do you realize that's the\nbiggest terror of most people?"
    } ]
  }, {
    "tStartMs": 925290,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "I might lose my pension too?"
    } ]
  }, {
    "tStartMs": 926650,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "- Yeah it's really sad that\nit's one of the biggest fears"
    } ]
  }, {
    "tStartMs": 930420,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "of everybody on a daily basis whether"
    } ]
  }, {
    "tStartMs": 932670,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "they're gonna get fired or not."
    } ]
  }, {
    "tStartMs": 934410,
    "dDurationMs": 3446,
    "segs": [ {
      "utf8": "And just seeing that my dad\npreviously and my mother"
    } ]
  }, {
    "tStartMs": 937856,
    "dDurationMs": 3784,
    "segs": [ {
      "utf8": "were both scared of not being\nable to support our family"
    } ]
  }, {
    "tStartMs": 941640,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "and now thankfully because\nwe followed your philosophy,"
    } ]
  }, {
    "tStartMs": 944240,
    "dDurationMs": 1619,
    "segs": [ {
      "utf8": "we have all the freedom in the world."
    } ]
  }, {
    "tStartMs": 945859,
    "dDurationMs": 1618,
    "segs": [ {
      "utf8": "- And your mother's a real estate agent."
    } ]
  }, {
    "tStartMs": 947477,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "She's an investor and real estate agent,"
    } ]
  }, {
    "tStartMs": 950167,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "and she can help you."
    } ]
  }, {
    "tStartMs": 951250,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "- [Alexandra] Yeah exactly."
    } ]
  }, {
    "tStartMs": 952310,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "Both of them are my team,"
    } ]
  }, {
    "tStartMs": 954697,
    "dDurationMs": 2003,
    "segs": [ {
      "utf8": "and tomorrow if I do get fired"
    } ]
  }, {
    "tStartMs": 956700,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "I have my properties to live off of."
    } ]
  }, {
    "tStartMs": 960173,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- You do too good a\njob for us to fire you."
    } ]
  }, {
    "tStartMs": 962153,
    "dDurationMs": 1575,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 963728,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "- [Alexandra] No I work hard here."
    } ]
  }, {
    "tStartMs": 965094,
    "dDurationMs": 1387,
    "segs": [ {
      "utf8": "- Are you afraid of being,"
    } ]
  }, {
    "tStartMs": 966481,
    "dDurationMs": 1396,
    "segs": [ {
      "utf8": "if you make a mistake in this company,"
    } ]
  }, {
    "tStartMs": 967877,
    "dDurationMs": 1023,
    "segs": [ {
      "utf8": "are fired?"
    } ]
  }, {
    "tStartMs": 968900,
    "dDurationMs": 1814,
    "segs": [ {
      "utf8": "- No mistakes are actually encourage."
    } ]
  }, {
    "tStartMs": 970714,
    "dDurationMs": 2896,
    "segs": [ {
      "utf8": "Coming from a traditional work system,"
    } ]
  }, {
    "tStartMs": 973610,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "where we're punished for it,"
    } ]
  }, {
    "tStartMs": 975120,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "and then coming to this\none where they're actually"
    } ]
  }, {
    "tStartMs": 976870,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "incentivized because we learn from them,"
    } ]
  }, {
    "tStartMs": 978780,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "it's amazing."
    } ]
  }, {
    "tStartMs": 979910,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "- Correct but you have to\nadmit you made a mistake."
    } ]
  }, {
    "tStartMs": 981477,
    "dDurationMs": 1943,
    "segs": [ {
      "utf8": "If you cover up the mistake you're fired."
    } ]
  }, {
    "tStartMs": 983420,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "- [Alexandra] Exactly."
    } ]
  }, {
    "tStartMs": 984700,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So Sarah my supervisor whenever"
    } ]
  }, {
    "tStartMs": 986700,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "I'm like, \"I'm so sorry I\ncan't believe I messed up.\""
    } ]
  }, {
    "tStartMs": 989520,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "She's like, \"No it's okay\nwe learn from our mistakes.\""
    } ]
  }, {
    "tStartMs": 992350,
    "dDurationMs": 1645,
    "segs": [ {
      "utf8": "- That's our culture here."
    } ]
  }, {
    "tStartMs": 993995,
    "dDurationMs": 1485,
    "segs": [ {
      "utf8": "- [Alexandra] It's awesome."
    } ]
  }, {
    "tStartMs": 995480,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- So thank you."
    } ]
  }, {
    "tStartMs": 996313,
    "dDurationMs": 987,
    "segs": [ {
      "utf8": "So the rich don't work for what?"
    } ]
  }, {
    "tStartMs": 997300,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- Money."
    } ]
  }, {
    "tStartMs": 998290,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "- And for those of you at home,"
    } ]
  }, {
    "tStartMs": 999580,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "find a friend and discuss this."
    } ]
  }, {
    "tStartMs": 1001220,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  } ]
}
